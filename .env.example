# Environment variables for the Python server
PORT=3000
UVICORN_RELOAD=true
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/sbp
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT_SECONDS=30
ALLOWED_ORIGINS=http://localhost:4200,http://localhost:3000
ENABLE_CREDITS=false

# Seqera Platform configuration
SEQERA_API_URL=https://api.example.com
SEQERA_ACCESS_TOKEN=replace-me
SEQERA_COMPUTE_ID=compute-env-id
SEQERA_WORK_SPACE=workspace-id
SEQERA_WORK_DIR=s3://bucket/workdir
# NCI Gadi project code used for PBS submissions. Optional; defaults to "yz52".
SEQERA_GADI_PROJECT=yz52
# Scheduler and Seqera health settings. Optional defaults are shown.
SEQERA_MAX_CONCURRENT_WORKFLOWS=25
SEQERA_WORKFLOW_SYNC_BATCH_LIMIT=50
SEQERA_HEALTH_CACHE_TTL_SECONDS=30
SEQERA_ENABLE_AGENT_HEALTHCHECK=false
SEQERA_HEALTHCHECK_AGENT_TIMEOUT_SECONDS=20

# AWS S3 Configuration for file uploads
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_REGION=ap-southeast-2
AWS_S3_BUCKET=your-private-bucket-name
# Optional: allows linking direct from the admin dashboard to AWS logs
AWS_LOG_GROUP=

# Workflow execution role guard
# Users must hold AUTH_WORKFLOW_EXECUTION_ROLE under DB_ADMIN_ROLES_CLAIM in the access token.
AUTH_WORKFLOW_EXECUTION_ROLE=biocommons/group/sbp_workflow_execution

# Auth provider configuration
AUTH_DOMAIN=your-auth-domain.example.com
AUTH_CLIENT_ID=your-auth-client-id
AUTH_CLIENT_SECRET=
AUTH_AUDIENCE=https://your-auth-audience.example.com
AUTH_ISSUER=
AUTH_ALGORITHMS=RS256
AUTH_REDIRECT_URI=http://localhost:3000/auth/callback
AUTH_REQUIRED_ROLE=biocommons/role/sbp/admin

# Optional DB debugging UI (Starlette Admin)
ENABLE_DB_ADMIN=false
DB_ADMIN_TITLE=SBP Backend Admin
DB_ADMIN_COOKIE_SECURE=true
DB_ADMIN_ROLES_CLAIM=https://biocommons.org.au/roles
DB_ADMIN_SESSION_SECRET=change-me-to-a-long-random-secret
DB_ADMIN_FORBIDDEN_HOME_URL=http://localhost:3000/
# Must be added as an allowed callback URL in your auth provider app settings.
DB_ADMIN_AUTH_REDIRECT_URI=http://localhost:3000/admin/login

# globus data staging configuration
GLOBUS_CLIENT_ID=service-account-client-id
GLOBUS_CLIENT_SECRET=globus-client-secret
GLOBUS_GADI_COLLECTION_ID=gadi-biocommons-collection-id
GLOBUS_S3_COLLECTION_ID=dev-globus-s3-collection-id
GLOBUS_GADI_COLLECTION_ROOT=on-gadi-collection-root
GLOBUS_INPUT_DIR=on-gadi-input-dir
GLOBUS_OUTPUT_DIR=on-gadi-output-dir

# GitHub App used to look up workflow repo commits (see workflow_repo_staging.py).
# Preferred over a personal access token since this is an org-owned service.
GITHUB_WORKFLOW_STAGING_AUTOMATION_APP_ID=github-app-id
GITHUB_WORKFLOW_STAGING_AUTOMATION_APP_PRIVATE_KEY=
# Local-dev-only fallback if you don't want to set up a GitHub App - never use in production.
GITHUB_WORKFLOW_STAGING_AUTOMATION_TOKEN=
